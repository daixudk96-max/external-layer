# external-layer configuration. Copy to .env.local (gitignored) and edit.
# bun loads .env/.env.local automatically for `bun run src/index.ts`.

# --- facade ---
# Port the facade listens on.
EXT_LAYER_PORT=17843
# Bearer key clients must send. If unset, a random sk-ext-layer-<hex> key is generated
# at startup and printed; set it here to keep clients working across restarts.
EXT_LAYER_API_KEY=

# --- upstream (the pristine codex-chatgpt-web you run yourself) ---
# Native Codex endpoint of your upstream `serve` process.
EXT_LAYER_UPSTREAM=http://127.0.0.1:17842
# Your upstream home directory (contains config.json: controlToken, experimentalBiggerContext,
# solAvailable/proAvailable, brokerSocketPath). Needed for /v1/context and turn interruption.
EXT_LAYER_UPSTREAM_HOME=

# --- ChatGPT credentials ---
# Where the Codex CLI / desktop app stores its ChatGPT login (auth.json).
# The layer refreshes the access token itself, so `login expired` stops being a manual chore.
EXT_LAYER_AUTH_JSON=

# --- trusted Codex environment (synthesized for envelope-less clients) ---
EXT_LAYER_CWD=
# Semicolon separated workspace roots.
EXT_LAYER_ROOTS=
EXT_LAYER_SANDBOX=danger-full-access

# --- timeouts (ms/s) ---
# Hard cap on a single upstream attempt: no bytes at all.
EXT_LAYER_FIRST_BYTE_MS=300000
# Progress budget: upstream must emit real content within this window, heartbeats do not count.
EXT_LAYER_PROGRESS_MS=240000
# Byte-silence budget.
EXT_LAYER_STALL_SEC=300
# Extra retries for navigation-stage failures (page.goto transport blips: the turn dies at
# second zero with no prompt attached). Independent of the generation-stage retry budget.
EXT_LAYER_NAV_RETRIES=2

# --- account capabilities (default: read from <upstream home>/config.json) ---
# Override only if you know better than the upstream home does.
EXT_LAYER_SOL_AVAILABLE=
EXT_LAYER_PRO_AVAILABLE=

# --- optional ---
# Idempotency store file. Replay is opt-in: it applies to requests carrying an explicit
# Idempotency-Key (and to /v1/chat/completions); a repeated /v1/responses history runs again.
EXT_LAYER_STATE=

# --- conversation continuation (default: on) ---
# One upstream ChatGPT conversation per client conversation; every reply carries
# x-ext-layer-conversation. Set to 0 to fall back to one fresh conversation per step.
EXT_LAYER_CONTINUATION=
# LRU bound on tracked conversations (default 64).
EXT_LAYER_CONVERSATION_LIMIT=
# Optional file so tracked conversations survive a restart.
EXT_LAYER_CONVERSATIONS=

# --- failure breaker (default: on) ---
# After 3 consecutive big-payload failures in one conversation the layer refuses
# further turns with HTTP 429 conversation_too_large (start a new conversation or
# compact) instead of churning stalled page turns for minutes. A fresh ChatGPT
# conversation pasted with a huge history stalls its own page DOM and fails nearly
# every time, and every failure releases the retained tab, so the next step
# re-pastes everything - the refusal breaks that spiral with an actionable error.
EXT_LAYER_BREAKER=
# Consecutive qualifying failures before refusal (default 3).
EXT_LAYER_BREAKER_THRESHOLD=
# A failure counts when the payload clears either gate: at least this many chars (default 150000),
# or at least the token cliff below (the live page reliability cliff: <20k tokens completes ~82%,
# >=20k tokens ~2% across 127 live turns).
EXT_LAYER_BREAKER_CHARS=
# The token cliff gate in estimated tokens (default 20000; content-aware ascii ~3.6 / cjk ~1.5
# chars per token, so ~72k ASCII chars and ~30k CJK chars both sit at ~20k tokens).
EXT_LAYER_BREAKER_TOKENS=
# Refusal window in ms before one attempt is allowed again (default 300000).
EXT_LAYER_BREAKER_COOLDOWN_MS=
