# external-layer configuration. Copy to .env.local (gitignored) and edit.
# bun loads .env/.env.local automatically for `bun run src/index.ts`.

# --- facade ---
# Port the facade listens on.
EXT_LAYER_PORT=17843
# Bearer key clients must send. If unset, a random sk-ext-layer-<hex> key is generated
# at startup and printed; set it here to keep clients working across restarts.
EXT_LAYER_API_KEY=

# --- upstream (the pristine codex-chatgpt-web you run yourself) ---
# Native Codex endpoint of your upstream `serve` process.
EXT_LAYER_UPSTREAM=http://127.0.0.1:17842
# Your upstream home directory (contains config.json: controlToken, experimentalBiggerContext,
# solAvailable/proAvailable, brokerSocketPath). Needed for /v1/context and turn interruption.
EXT_LAYER_UPSTREAM_HOME=

# --- ChatGPT credentials ---
# Where the Codex CLI / desktop app stores its ChatGPT login (auth.json).
# The layer refreshes the access token itself, so `login expired` stops being a manual chore.
EXT_LAYER_AUTH_JSON=

# --- trusted Codex environment (synthesized for envelope-less clients) ---
EXT_LAYER_CWD=
# Semicolon separated workspace roots.
EXT_LAYER_ROOTS=
EXT_LAYER_SANDBOX=danger-full-access

# --- timeouts (ms/s) ---
# Hard cap on a single upstream attempt: no bytes at all.
EXT_LAYER_FIRST_BYTE_MS=300000
# Progress budget: upstream must emit real content within this window, heartbeats do not count.
EXT_LAYER_PROGRESS_MS=420000
# Byte-silence budget.
EXT_LAYER_STALL_SEC=300

# --- account capabilities (default: read from <upstream home>/config.json) ---
# Override only if you know better than the upstream home does.
EXT_LAYER_SOL_AVAILABLE=
EXT_LAYER_PRO_AVAILABLE=

# --- optional ---
# Idempotency store file (same request body -> byte-identical replay).
EXT_LAYER_STATE=
